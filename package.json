{
  "name": "cv-tailor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "prettier --check . && pnpm -r run --if-present check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "pnpm -r run --if-present generate",
    "contracts:check": "bash scripts/check-contracts.sh"
  },
  "devDependencies": {
    "@cv-tailor/config": "workspace:*",
    "prettier": "^3.9.9"
  }
}
