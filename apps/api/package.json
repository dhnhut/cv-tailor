{
  "name": "@cv-tailor/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "build": "esbuild pre-sign-up/index=src/triggers/pre-sign-up/handler.ts me/index=src/handlers/me/handler.ts create-document/index=src/handlers/documents/create.ts list-documents/index=src/handlers/documents/list.ts delete-document/index=src/handlers/documents/delete.ts --bundle --platform=node --target=node24 --format=cjs --outdir=dist"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1145.0",
    "@aws-sdk/client-dynamodb": "^3.1145.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@cv-tailor/contracts": "workspace:*"
  },
  "devDependencies": {
    "@cv-tailor/config": "workspace:*",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "5.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
