{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProtectOrgTrailBucket",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketOwnershipControls"
      ],
      "Resource": ["arn:aws:s3:::org-trail-logs-*", "arn:aws:s3:::org-trail-logs-*/*"]
    }
  ]
}
