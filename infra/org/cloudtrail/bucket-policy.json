{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AWSCloudTrailAclCheck",
      "Effect": "Allow",
      "Principal": { "Service": "cloudtrail.amazonaws.com" },
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::org-trail-logs-${LOG_ARCHIVE_ACCOUNT_ID}",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:cloudtrail:us-east-1:${MGMT_ACCOUNT_ID}:trail/org-trail"
        }
      }
    },
    {
      "Sid": "AWSCloudTrailWrite",
      "Effect": "Allow",
      "Principal": { "Service": "cloudtrail.amazonaws.com" },
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::org-trail-logs-${LOG_ARCHIVE_ACCOUNT_ID}/AWSLogs/${MGMT_ACCOUNT_ID}/*",
        "arn:aws:s3:::org-trail-logs-${LOG_ARCHIVE_ACCOUNT_ID}/AWSLogs/${ORG_ID}/*"
      ],
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "aws:SourceArn": "arn:aws:cloudtrail:us-east-1:${MGMT_ACCOUNT_ID}:trail/org-trail"
        }
      }
    },
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::org-trail-logs-${LOG_ARCHIVE_ACCOUNT_ID}",
        "arn:aws:s3:::org-trail-logs-${LOG_ARCHIVE_ACCOUNT_ID}/*"
      ],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    }
  ]
}
