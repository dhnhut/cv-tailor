# Copy to infra/.env (gitignored) and fill in. Account IDs are not committed (ADR-0004 §2).
# scripts/tofu.sh reads this file. A value set in the shell wins.
# Find each ID with: aws sts get-caller-identity --profile cvt-<env> --query Account --output text
CVT_DEV_ACCOUNT_ID=
CVT_STAG_ACCOUNT_ID=
CVT_PROD_ACCOUNT_ID=

# Budget alert address (S1-09). Not committed, because the repository is public. Only the baseline
# stack needs it (scripts/tofu.sh).
CVT_ALERT_EMAIL=
